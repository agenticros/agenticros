@@ -14,6 +14,8 @@
 
 'use strict';
 
+const DistroUtils = require('../../lib/distro.js');
+
 /**
  * Generate JavaScript message class code using native template literals
  * This replaces the doT template engine with pure JavaScript
@@ -159,6 +161,19 @@ function isPrimitivePackage(baseType) {
   return primitiveBaseType.indexOf(baseType.type) !== -1;
 }
 
+// Lyrical grew rosidl primitive sequences by two trailing bools. Message
+// sequences stayed data/size/capacity. Only the std_msgs primitive wrappers
+// are those primitive sequences, and the flags stay false because rclnodejs
+// owns the buffer itself.
+function primitiveSequenceTail() {
+  if (DistroUtils.getDistroId() < DistroUtils.DistroId.LYRICAL) {
+    return '';
+  }
+  return `,
+  is_rosidl_buffer: ref.types.bool,
+  owns_rosidl_buffer: ref.types.bool`;
+}
+
 function isTypedArrayType(type) {
   return typedArrayType.indexOf(type.type.toLowerCase()) !== -1;
 }
@@ -347,7 +362,7 @@ ${
     : `  data: ${refArrayType},`
 }
   size: ref.types.size_t,
-  capacity: ref.types.size_t
+  capacity: ref.types.size_t${isPrimitivePackage(spec.baseType) ? primitiveSequenceTail() : ''}
 });
 
 ${generateWrapperClass()}
